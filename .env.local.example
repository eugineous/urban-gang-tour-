# Secret token to protect /api/automate from unauthorized calls
AUTOMATE_SECRET=your_secret_token_here

# Upstash Redis (for deduplication) — get from https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_page_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# Facebook Graph API
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Google OAuth (used to gate community photo uploads - "Wanjapi")
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret

# Meta auto-posting (Facebook Page + Instagram Business) — server-side only.
# Used by lib/meta-social.ts to auto-post new articles on publish and by the
# admin Comms composer. Leave empty until Meta app review clears.
# Facebook Page ID (facebook.com/profile.php?id=61572771956199 -> About -> Page ID)
META_FB_PAGE_ID=
# Long-lived PAGE access token with pages_manage_posts + pages_read_engagement
META_FB_PAGE_TOKEN=
# Instagram Business account ID linked to the Page (Graph API: me/accounts -> instagram_business_account)
META_IG_USER_ID=
# Token with instagram_basic + instagram_content_publish
META_IG_TOKEN=

# Stripe card payments (test keys until the account is activated for live)
# Secret key (sk_test_... / sk_live_...) - server-side only, never client-exposed
STRIPE_SECRET_KEY=
# Publishable key (pk_test_... / pk_live_...) - safe for the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret (whsec_...) of the dashboard webhook endpoint
# https://urbangangtour.co.ke/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# WhatsApp Business Platform (Meta)
# WHATSAPP_VERIFY_TOKEN: paste the same value into the Meta webhook config "Verify token" field
WHATSAPP_VERIFY_TOKEN=
# From Meta app dashboard: WhatsApp > API Setup
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# App secret: Meta app > Settings > Basic
WHATSAPP_APP_SECRET=
# Auto-post targets: "fb,ig" (default) posts articles to both directly.
# Set to "ig" if Instagram-to-Facebook cross-posting is on for the page,
# so Facebook is not posted twice per article.
META_AUTOPOST_TARGETS=

# Paystack (cards for Kenyan merchants; test keys from dashboard.paystack.com
# Settings > API Keys & Webhooks; live keys after compliance approval)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Required in production: strong random secret for signing admin/user session
# cookies (session forgery is possible without it)
SESSION_SECRET=
# Backup admin login code for the Control Room (Google sign-in is primary).
# Rotate immediately if it ever appears in served HTML, logs, or chat.
ADMIN_ACCESS_CODE=

# Google AdSense (dormant until set; even then loads only after cookie consent)
# Your publisher id from the AdSense dashboard, form ca-pub-XXXXXXXXXXXXXXXX.
# Setting this alone enables Auto Ads site-wide (incl. the v25 SPA pages) and
# publishes /ads.txt automatically.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional: manual ad-unit slot ids (create the units in the AdSense dashboard
# after approval). Leave blank to rely on Auto Ads only.
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
